# Local development only. Paper/backtest mode needs none of this.
# Binance's public API 451s requests from most cloud/datacenter IPs (geo/
# eligibility restriction) — kraken, coinbase, and bitstamp don't.
EXCHANGE_ID=kraken
SYMBOL=BTC/USD
TIMEFRAME=1h
STARTING_BALANCE_USD=10000

# Leave these unset unless you are deliberately going live. Never commit
# real values — Config refuses to start in live mode without both set.
LIVE_TRADING=false
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
