# Local development only. Copy to .env and fill in what you have.

# Where the JSON-file store keeps ingested mentions. Defaults to ./data.
TICKER_DATA_DIR=./data

# API server port (npm run serve). Defaults to 4000.
PORT=4000

# --- Reddit (real, working) ---
# Free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=cryptotrader-sentiment-monitor:0.1.0 (by /u/yourusername)
REDDIT_SUBREDDITS=CryptoCurrency,CryptoMarkets

# --- X/Twitter (stub — needs a paid API plan) ---
TWITTER_BEARER_TOKEN=

# --- Telegram (stub — needs a free bot token + the bot joined to channels) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=

# --- Discord (stub — needs a free bot token + the bot invited to servers) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNELS=
